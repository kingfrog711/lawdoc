# HuggingFace token — used to authenticate to the inference endpoint (Modal/HF)
# Get one at: https://huggingface.co/settings/tokens
# Must have READ access to sirpratama/perdata-gemma4-lora-v2 (the private LoRA repo)
HF_API_KEY=your_huggingface_token_here

# OpenAI-compatible inference endpoint URL (Modal/vLLM).
# Deploy: `modal deploy modal_app.py` from the project root — it prints the URL.
# Example: https://your-username--lawdoc-vllm-serve.modal.run
HF_ENDPOINT_URL=

# LoRA adapter name exposed by the vLLM server's --lora-modules flag.
# Must match the name set in modal_app.py (LORA_NAME). Default: perdata-lora
HF_LORA_ADAPTER_NAME=perdata-lora

# LlamaCloud API key — required for /parse-document (PDF, DOCX, images, etc.)
# Get one free at: https://cloud.llamaindex.ai (1000 pages/day free tier)
# Used when the chat attaches a file — backend parses it before sending to the model
LLAMA_CLOUD_API_KEY=your_llama_cloud_key_here

# Google AI Studio key — only needed for /ocr-explain legacy endpoint (image OCR)
# Get one free at: https://aistudio.google.com/app/apikey
# Leave blank if you don't need the legacy image analysis endpoint
GOOGLE_API_KEY=your_google_ai_studio_key_here
