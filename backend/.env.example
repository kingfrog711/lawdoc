# HuggingFace token — required for /consult and /tanya
# Get one at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_token_here

# Dedicated HF Inference Endpoint URL — strongly recommended (LoRA model not on serverless API)
# Deploy from: https://huggingface.co/sirpratama/perdata-gemma4-lora-v2 → Deploy → Inference Endpoints
# Leave blank to attempt direct model-ID call (will likely fail without a deployed endpoint)
HF_ENDPOINT_URL=

# Google AI Studio key — only needed for /ocr-explain (image extraction step)
# Get one free at: https://aistudio.google.com/app/apikey
# Leave blank if you don't need document image analysis
GOOGLE_API_KEY=your_google_ai_studio_key_here
